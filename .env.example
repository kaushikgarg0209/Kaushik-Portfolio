# Database — Vercel sets POSTGRES_URL automatically when you add
# the "Postgres" storage integration in your Vercel project dashboard.
POSTGRES_URL=

# File uploads — Vercel sets BLOB_READ_WRITE_TOKEN automatically when you
# add the "Blob" storage integration in your Vercel project dashboard.
BLOB_READ_WRITE_TOKEN=

# Auth (generate secret: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Admin seed credentials (used by npm run db:seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-secure-password

# Contact form email (optional)
# RESEND_API_KEY: API key from https://resend.com — used to email you when
# someone submits the contact form. Without it, messages are still saved in
# the admin inbox (/admin/messages), but no email is sent.
RESEND_API_KEY=
CONTACT_EMAIL=your-email@example.com
